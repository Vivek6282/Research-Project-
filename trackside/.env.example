# =================================================================-----------
# TRACKSIDE — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# =================================================================-----------

# Security & Environment Mode
# Set to 'production' in deployed environments (enforces HTTPS/secure cookies)
DJANGO_ENV=production

# Set to False in production
DEBUG=False

# Cryptographically random string (min 50 chars). Do NOT share or commit!
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Hostnames allowed to serve requests
ALLOWED_HOSTS=localhost,127.0.0.1,trackside.example.com

# CORS Allowed Origins for Frontend SPA requests
CORS_ALLOWED_ORIGINS=https://trackside.example.com,http://localhost:5173

# Database Connection URL (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://trackside_user:trackside_password@localhost:5432/trackside

# Redis URL for Django Channels WebSocket group layers
REDIS_URL=redis://127.0.0.1:6379/0
