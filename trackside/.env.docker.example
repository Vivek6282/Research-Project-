# Trackside — Docker Compose Environment Configuration Example
# Copy to .env.docker and populate with secure production values

POSTGRES_DB=trackside
POSTGRES_USER=trackside_user
POSTGRES_PASSWORD=generate-a-secure-database-password-here
SECRET_KEY=generate-a-strong-random-django-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,backend
