# Show the demo controls (Play demo, Stop, Open live visualizer) in the Coach "Maps & Demo" tab.
# When false or removed the tab still shows maps and the corner editor but hides every demo control.
# The server must ALSO allow it: DEMO_TOOLS_ENABLED=true and DJANGO_ENV not production (see backend/.env.example).
# NOTE: Must be false (or removed) for real academy deployments
VITE_ENABLE_DEMO_TOOLS=true

# Display name of the racing academy
VITE_ACADEMY_NAME=Trackside
