# Trackside Backend — Local Development Environment Template
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=dev-secret-key-trackside-local-1234567890-secure-key
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_ENGINE=sqlite3
ADMIN_EMAIL=admin@trackside.local
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=System Admin

# Demo Tools: Play demo in the Coach Maps & Demo tab (local demo only, never production or Docker)
DEMO_TOOLS_ENABLED=false
# Optional custom Python executable path for simulator child process
DEMO_PYTHON=
