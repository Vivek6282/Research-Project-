# Trackside — Caddy: automatic HTTPS, the built frontend, and the proxy to the backend.
# DOMAIN comes from .env (see docker-compose.yml). Caddy gets and renews the certificate by itself.

{$DOMAIN} {
	encode zstd gzip

	# Track imports are the largest uploads
	request_body {
		max_size 12MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API and live WebSocket traffic go to the backend. The client's own X-Forwarded-For is
	# never passed on: it is replaced with the address Caddy really saw, so rate limits cannot be dodged.
	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /ws/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Everything else is the single-page app
	handle {
		root * /srv

		# Hashed build files never change: cache them for a year
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# index.html, sw.js and the rest are re-checked every time so an update shows up at once
		@revalidate {
			not path /assets/*
		}
		header @revalidate Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
