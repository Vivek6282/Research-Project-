# Trackside production settings. ONE file for the whole stack.
#   cp .env.production.example .env      (in the same folder as docker-compose.yml)
#   then edit .env. The file .env is git-ignored: never commit it, never paste it into a chat or a log.
#
# Generation hints (run on any computer with Python):
#   SECRET_KEY, POSTGRES_PASSWORD, REDIS_PASSWORD:
#       python -c "import secrets; print(secrets.token_urlsafe(50))"
#   (token_urlsafe only uses letters, digits, - and _, which are safe inside the connection URLs.
#    If you choose your own passwords, use only letters and digits.)

# --- Django ---------------------------------------------------------------
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-me-with-a-long-random-value

# --- Your domain (the DNS A record must point at this server) ---------------
DOMAIN=trackside.example.com
# Keep localhost and 127.0.0.1: the container health check calls the backend as "localhost".
ALLOWED_HOSTS=trackside.example.com,localhost,127.0.0.1
# Every entry must start with https:// (comma separated)
CORS_ALLOWED_ORIGINS=https://trackside.example.com
# Optional extra trusted origins (comma separated, https://). The CORS origins are trusted too.
CSRF_TRUSTED_ORIGINS=
# Number of reverse proxies in front of the backend (Caddy = 1)
TRUSTED_PROXY_COUNT=1

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=trackside
POSTGRES_USER=trackside_user
POSTGRES_PASSWORD=replace-me-with-a-long-random-value

# --- Redis (live updates) -----------------------------------------------------
REDIS_PASSWORD=replace-me-with-a-long-random-value
