# Trackside Virtual Lap Simulator - Configuration Example
# Copy this file to .env in this directory and populate with real values:
#   copy .env.example .env

# Hardware Serial connection for Bridge ESP32 (optional)
# "auto" finds the bridge board whatever COM number Windows gave it. Or name a port (for example COM5):
# it is checked first, and if it is not the bridge the other ports are searched.
SERIAL_PORT=auto
SERIAL_BAUD=115200

# Backend Integration (Optional, only for running the simulator by hand from a terminal)
# A demo started from the Coach "Maps & Demo" tab does NOT need these: the server passes its own
# SESSION_ID, DEVICE_TOKEN, BACKEND_URL and DEMO_ZONES as environment variables, and those always win over this file.
# For a manual run, generate SESSION_ID, DEVICE_TOKEN, and DEMO_ZONES by running in trackside/backend:
#   python manage.py seed_demo --driver-email <driver_email>
# Leave SESSION_ID, DEVICE_TOKEN, and DEMO_ZONES empty so copying this file unchanged does NOT enable backend posting.
BACKEND_URL=http://localhost:8000
# Example: SESSION_ID=00000000-0000-0000-0000-000000000000
SESSION_ID=
# Example: DEVICE_TOKEN=dt_your_generated_device_token_here
DEVICE_TOKEN=
# Example: DEMO_ZONES={"Hairpin":"00000000-0000-0000-0000-000000000001","Sweeper":"00000000-0000-0000-0000-000000000002","Chicane":"00000000-0000-0000-0000-000000000003"}
DEMO_ZONES=

# Local WebSocket Telemetry Broadcaster
WS_HOST=127.0.0.1
WS_PORT=8765
# Set to false to harden origin checks (disallows Origin: null from direct file opening)
WS_ALLOW_NULL_ORIGIN=true
# Comma-separated list of allowed origins (defaults to http://localhost:5173,http://127.0.0.1:5173)
# WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
